# ==========================================================
# OrchardLease Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# ==========================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/orchardlease

# --- JWT / Auth ---
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
PASSWORD_RESET_EXPIRES_IN=30m
EMAIL_VERIFY_EXPIRES_IN=1d

# --- Cookies ---
COOKIE_SECRET=replace_with_random_cookie_secret
COOKIE_DOMAIN=localhost

# --- Admin (single admin from env) ---
ADMIN_EMAIL=admin@orchardlease.com
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_NAME=Platform Admin

# --- Security ---
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MS=900000

# --- Cloudinary (placeholder — wire real keys when ready) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_PROVIDER=local

# --- Email (placeholder SMTP) ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@orchardlease.com

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Feature flags ---
MAINTENANCE_MODE=false
